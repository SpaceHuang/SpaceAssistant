  "cards": [
    {
      "dot": "rose",
      "title": "当前架构",
      "items": [
        "微信与飞书各存安全设置，新增渠道会增加分支",
        "IM 路径常要求逐次确认；部分调用没有进入审核 Agent",
        "外发兜底与异步待办规则存在不一致"
      ]
    },
    {
      "dot": "emerald",
      "title": "目标架构",
      "items": [
        "微信、飞书只做身份和能力适配，共用 IM 策略域",
        "完整事实经确定性规则与审核 Agent；不确定时进入异步待办",
        "派发前复核版本和动作，所有回复与外发经过统一边界"
      ]
    },
    {
      "dot": "amber",
      "title": "实施约束",
      "items": [
        "新增设计尚未实现；自动审核仍受门禁控制",
        "人审、禁止、可自动审核保持不同语义",
        "策略统一不共享身份、待办或跨渠道批准"
      ]
    }
