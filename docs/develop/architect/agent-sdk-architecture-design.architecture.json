  "cards": [
    {
      "dot": "cyan",
      "title": "SDK 承诺",
      "items": [
        "一次调用可独立发起、可取消、可嵌套",
        "Core 不依赖 Electron、SQLite 或具体厂商 SDK",
        "History Port 保证消息记录可读取、可重建、可恢复"
      ]
    },
    {
      "dot": "emerald",
      "title": "产品宿主",
      "items": [
        "Driver 只负责谁发起、何时发起、结果给谁",
        "Storage Adapter 负责 SQLite / JSONL、迁移、索引和保留期",
        "桌面、远程、管家共用同一条 SDK 调用路径"
      ]
    },
    {
      "dot": "violet",
      "title": "替换轴",
      "items": [
        "Anthropic / OpenAI / 其他实现统一接入 ModelProvider",
        "完整第三方 Agent SDK 只有满足生命周期契约才可直接替换",
        "Provider 差异封装在 Adapter，不泄漏到 Core"
      ]
    },
    {
      "dot": "emerald",
      "title": "偏差 D0 · 目录与包边界",
      "items": [
        "状态：已满足 SDK 包边界与入口闭包；Owner：Agent SDK + Electron composition",
        "证据：packages/agent-sdk 独立 typecheck；入口闭包零 Electron / shared / Renderer / SQLite；shared 单向依赖护栏通过",
        "回滚：只回滚 Hosted 执行路由；不移除 SDK 公共包或依赖护栏"
      ]
    },
    {
      "dot": "emerald",
      "title": "偏差 D1 · 执行契约",
      "items": [
        "状态：四 lane 与嵌套 Approval 均通过 Hosted SDK 执行；宿主负责 admission、审批与产品投影",
        "证据：Desktop / Feishu / WeChat / Automation 真实 caller 与 fail-stop；SDK turn lifecycle、取消及 terminal tests",
        "回滚：按 lane 回退执行路由；已提交 History 与副作用不重放"
      ]
    },
    {
      "dot": "emerald",
      "title": "偏差 D2 · Provider 替换",
      "items": [
        "状态：SDK 使用规范化 ModelProvider SPI；生产 route 仅开放白名单 Anthropic，Chat / Responses 保持 fake contract；Hosted request 由宿主映射为 canonical SDK request，pi-ai adapter 负责 Anthropic wire",
        "Owner：packages/agent-provider-pi-ai + Electron Hosted request adapter。证据：四 lane 与嵌套 Approval Hosted caller、Anthropic mock-wire golden、route 冻结、stream/tool/usage 与拒绝矩阵；Electron/SDK typecheck 和 package closure 门禁通过",
        "回滚：只切换执行 route/provider adapter；V2-C lane 不恢复 legacy 安全门控，不重放已提交 History/副作用"
      ]
    },
    {
      "dot": "emerald",
      "title": "偏差 D3 · Storage 边界",
      "items": [
        "状态：canonical HistoryPort 驱动 Hosted replay、SQLite 重建与 restart recovery；SessionEvent/JSONL 为兼容投影",
        "证据：四 lane History caller、SQLite crash/restart、compaction、retry/outbox 与 terminal recovery tests",
        "回滚：只回退 Runtime 读兼容 adapter；不得双写或重放已提交副作用"
      ]
    },
    {
      "dot": "emerald",
      "title": "偏差 D4 · 能力与安全",
      "items": [
        "状态：四 lane 与嵌套 Approval 共用 CapabilityRegistry、SafetyGate、permit-bound ExecutionPort；V2-C 已收口",
        "证据：initial/recheck、撤销、身份漂移、fail-stop、确认取消与零 executor 调用聚焦 tests",
        "Owner / 回滚：SDK Safety contracts + lane Host adapters；保持 deny/fail-closed，不恢复旧 gate"
      ]
    },
    {
      "dot": "rose",
      "title": "版本路线",
      "items": [
        "V0 盘点依赖并冻结目录边界、契约词汇和禁止依赖",
        "V1 建立 packages/agent-sdk 物理边界，src/shared/agent 只作迁移转发",
        "V2 抽出 History / Provider / Capability SPI，双跑内存与 SQLite 实现",
        "V3 切换全部 Driver，删除旧入口，发布可复制 SDK"
      ]
    },
    {
      "dot": "slate",
      "title": "持续验收",
      "items": [
        "每个偏差必须有 owner、版本、状态、证据和回滚点",
        "每个版本更新本页偏差清单，而不是只更新目录",
        "页面中的边界是约束：依赖方向只能向端口收敛"
      ]
    }
  ]
}
