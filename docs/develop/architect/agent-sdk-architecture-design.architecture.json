    { "dot": "amber", "title": "偏差 D1 · 执行契约", "items": ["现状：Agent 入口、装配、循环、工具和存储横跨 electron / src/shared", "理想：SDK 只暴露 Invocation、History Port、Provider Port、Capability Port 等稳定契约", "验收：SDK 可脱离 Electron 构建、测试，并可被第二个宿主接入"] },
    { "dot": "rose", "title": "偏差 D2 · Provider 替换", "items": ["现状：toolChatLoop 与 Anthropic client 仍存在直接耦合", "理想：ModelProvider 只暴露规范化流、工具调用、用量和错误", "验收：替换 Provider 不改 Core 与产品 Driver"] },
    { "dot": "slate", "title": "偏差 D3 · Storage 边界", "items": ["现状：messages / turns / events 的读取、重建和 SQLite 查询分散在 electron", "理想：SDK 定义 Message / Turn / Event 记录语义与 History Port；宿主实现存储", "验收：内存或 JSONL 实现可重建同一份 canonical history；切换 SQLite 不改 Core"] },
    { "dot": "orange", "title": "偏差 D4 · 能力与安全", "items": ["现状：工具注册、确认、策略、宿主副作用分散在主进程", "理想：Capability Registry 与 Safety Boundary 成为 SDK 端口", "验收：未注册能力不可执行；高风险调用统一 fail-closed"] },
    { "dot": "rose", "title": "版本路线", "items": ["V0 盘点依赖并冻结目录边界、契约词汇和禁止依赖", "V1 建立 packages/agent-sdk 物理边界，src/shared/agent 只作迁移转发", "V2 抽出 History / Provider / Capability SPI，双跑内存与 SQLite 实现", "V3 切换全部 Driver，删除旧入口，发布可复制 SDK"] },
    { "dot": "slate", "title": "持续验收", "items": ["每个偏差必须有 owner、版本、状态、证据和回滚点", "每个版本更新本页偏差清单，而不是只更新目录", "页面中的边界是约束：依赖方向只能向端口收敛"] }
