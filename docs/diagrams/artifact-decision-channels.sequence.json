    { "from": 590, "to": 750, "label": "恢复 · 写入 · 登记" }
  ],
  "messages": [
    { "id": "prepare", "from": "loop", "to": "resolver", "y": 190, "label": "prepareArtifactToolWrite（写入意图）", "variant": "emphasis" },
