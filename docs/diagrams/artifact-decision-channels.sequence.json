  "cards": [
    {
      "dot": "emerald",
      "title": "原子提交",
      "items": [
        "桌面 IPC 与 IM 入站共用 submitArtifactDecisionResponse",
        "提交临界区完全同步，先到先得，无双消费",
        "败者返回 stale；绑定不匹配返回 binding_mismatch"
      ]
    },
    {
      "dot": "rose",
      "title": "IM 侧约束",
      "items": [
        "入站必须先过私聊 + 绑定 guard（source/authOwner/privateChatTarget）",
        "UUID 前缀抽取先于候选数判断，零候选也由决策处理器消费",
        "IM 出站失败立即取消本轮，桌面卡同时失效（失败关闭）",
        "回复参与平台 processed-store 去重，不创建新 Agent 请求"
      ]
    },
    {
      "dot": "orange",
      "title": "生命周期",
      "items": [
        "waiter TTL 5 分钟；超时 / abort / 出站失败统一 settle",
        "owner 级 tombstone TTL 10 分钟，迟到回复得 stale",
        "重注册同一 waiter 键会 replaced 旧决策"
      ]
    }
  ]
}
