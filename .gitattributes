# 生成产物固定用 LF：生成器（scripts/generate-i18n-types.ts）写的是 LF，
# 而 core.autocrlf=true 的机器上 git 检出为 CRLF，导致每次 build/pack 触发
# prebuild:renderer 重新生成后，git status 显示「已修改」但 diff 为空（内容其实一致）。
src/renderer/i18n/types.ts text eol=lf

# tree-sitter wasm 为二进制资产（P0-T2）：禁止换行符转换破坏 SHA256SUMS 哈希
*.wasm binary
# node-types.json 同为哈希管控资产：合并/检出时的 CRLF 转换会破坏校验（合并 main 实测），一并标 binary
resources/tree-sitter/*.json binary
# Golden 样本/基线按字节比对（多行样本 here-string 对行尾敏感）：禁止换行符转换
electron/shell/testdata/golden/** binary
